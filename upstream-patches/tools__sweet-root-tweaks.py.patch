+def wallpapers(fs):
+    # The stock layered wallpapers need the A11 HEVC decoder (HEIC layers); give each a PNG twin and point main.caml at it
+    # (same idea as ios-sailfish tools/wallpaper-heic2png.sh, which needs macOS sips). Optional: needs heif-convert
+    # (Debian: sudo apt install libheif-examples); without it the wallpapers show only their background gradient.
+    base = 'Library/Wallpaper/Collections'
+    tool = shutil.which('heif-convert')
+    if not fs.isdir(base):
+        return
+    if not tool:
+        print('wallpapers: heif-convert not found: HEIC layers left as they are (apt install libheif-examples)')
+        return
+    n = 0
+    for dp, dn, fn in fs.walk(base):
+        for f in fn:
+            if f.upper().endswith('.HEIC'):
+                heic = os.path.join(dp, f)
+                png = heic.rsplit('.', 1)[0] + '.png'
+                if not fs.exists(png):
+                    fs.heic_to_png(tool, heic, png)
+                n += 1
+            elif f == 'main.caml':
+                p = os.path.join(dp, f)
