+class Plan:
+    """Read SRC (never written) and record the changes: self.ops (sh lines, run with R=target root) and
+    self.tar (files with explicit owner and mode). `guard` = rel paths that a LATER step adds to the tree (the
+    cryptex hard links of tools/ios-root-plan.py): looking at one raises, since Live would see a different tree."""
+
+    def __init__(self, src, tar, guard=()):
+        self.src, self.tar, self.ops = src, tar, []
+        self.guard = set(guard)
+        self.guard_dirs = {os.path.dirname(g) for g in self.guard}
+        self.new_dirs, self.new_files, self.gone = set(), set(), set()
+
+    def p(self, rel):
+        return os.path.join(self.src, rel)
+
+    def sh(self, *words):
+        self.ops.append(' '.join(words))
+
+    def q(self, rel):
+        return '"$R"/' + shlex.quote(rel)
+
+    def _look(self, rel, dir_=False):
+        rel = os.path.normpath(rel)
+        if rel in self.guard or (dir_ and any(d == rel or d.startswith(rel + '/') for d in self.guard_dirs)):
+            raise RuntimeError(f'plan: {rel} is looked at, but a later step changes it: model that step first')
+        return rel
+
+    def exists(self, rel):
+        rel = self._look(rel)
+        return rel in self.new_dirs or rel in self.new_files or (rel not in self.gone and os.path.exists(self.p(rel)))
+
+    def isdir(self, rel):
+        rel = self._look(rel, True)
+        return rel in self.new_dirs or (rel not in self.new_files and rel not in self.gone and os.path.isdir(self.p(rel)))
+
+    def listdir(self, rel):
+        return os.listdir(self.p(self._look(rel, True)))
 
+    def glob(self, pattern):
+        for g in self.guard:
+            if fnmatch.fnmatch(g, pattern):
+                self._look(g)
+        return [os.path.relpath(g, self.src) for g in glob.glob(self.p(pattern))]
 
